DATABASE_URL=sqlite:///./data/handscript.db
EMBEDDED_WORKER=true
STORAGE_DIR=./data/files
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=handscript
# S3_ACCESS_KEY=handscript
# S3_SECRET_KEY=handscriptsecret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HANDWRITING_ENGINE=graves
GRAVES_ENABLED=true
GRAVES_WEIGHTS_PATH=./data/graves/weights.npz
GRAVES_STYLES_DIR=./data/graves/styles
GRAVES_DEFAULT_STYLE_ID=9
# HandwritingAgent profile only. Leave the key empty in source control.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview

# One-DM Diffusion Mimicker engine (ECCV 2024). Runs on AMD RX 580 (DirectML), CUDA, or CPU.
ONEDM_ENABLED=true
ONEDM_WEIGHTS_PATH=./data/onedm/weights/epoch-ckpt.pt
ONEDM_DEVICE=auto
